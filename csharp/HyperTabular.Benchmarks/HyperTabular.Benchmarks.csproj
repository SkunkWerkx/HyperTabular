<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- One framework, so `dotnet run` needs no -f; the receipts are measured on .NET 11. -->
		<TargetFrameworks>net11.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<IsPublishable>false</IsPublishable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<!-- BenchmarkDotNet requires [Benchmark] methods to be instance methods. -->
		<NoWarn>$(NoWarn);CA1822;CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- Prereleases too: 0.15.x knows no runtime past .NET 10 and stops in its SDK validation
		     on net11.0, and the 0.16 previews know .NET 11. Back to * when 0.16.0 ships stable. -->
		<PackageReference Include="BenchmarkDotNet" Version="*-*" />
		<ProjectReference Include="..\HyperTabular\HyperTabular.csproj" />
	</ItemGroup>

</Project>
