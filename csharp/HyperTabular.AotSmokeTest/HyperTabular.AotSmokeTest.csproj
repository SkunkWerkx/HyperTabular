<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../HyperTabular/HyperTabular.csproj" />
	</ItemGroup>

	<!-- A project reference gets none of a NuGet package's build/ imports, so the file a real
	     consumer has imported for it is imported by hand here: this is the project that proves
	     the Native AOT wiring in it. The archive it links is
	     csharp/HyperTabular/staticlibs/{rid}/, which is not committed — the forge's
	     static-libs/build-static-libs.sh stages it, in CI and by hand. Where it is absent the
	     publish loads the shared library. -->
	<Import Project="../HyperTabular/build/net11.0/HyperTabular.targets" />

</Project>
