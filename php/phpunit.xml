<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true">
    <php>
        <!-- The workbook corpus, decoded, is some 40 MB, and its data provider and the replay
             with every buffer starting at one element each hold a copy. -->
        <ini name="memory_limit" value="512M"/>
    </php>
    <testsuites>
        <testsuite name="hypertabular">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
