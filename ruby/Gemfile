# frozen_string_literal: true

source "https://rubygems.org"

gemspec

# The test, benchmark and formatting gems; rake and yard are the gemspec's own development
# dependencies, since `rake build` and `rake docs:check` are part of packaging the gem.
group :development do
  gem "benchmark-ips", "~> 2.15"
  gem "rspec", "~> 3.13"
  # The formatter: .rubocop.yml enables the layout cops only, over every Ruby file in the gem.
  gem "rubocop", "~> 1.91", require: false
end

# Development builds against the HyperCast checkout beside this one: HyperForge's workspace/Gemfile.peers names its
# gem by path. The Forge allows exactly these two lines and fails a CI leg in which the file they name exists
# (companion_fetch.py, gemfile_evals); a CI checkout never has it.
peers = File.expand_path("../../Gemfile.peers", __dir__)
eval_gemfile peers if File.exist?(peers) && ENV["CI"].nil?
