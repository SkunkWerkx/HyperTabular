<Project Sdk="Microsoft.NET.Sdk">

	<!-- The package on iOS and Mac Catalyst, as an app: the same SmokeTest.Run() the Native AOT
	     smoke test runs, crossing every native entry point, built for the two platforms where the
	     core is linked into the app's executable and reached as "__Internal". It needs a Mac
	     with Xcode and the ios and maccatalyst workloads, so it is not in HyperTabular.slnx,
	     which every other leg builds; CI's test-apple-mobile job builds it three ways (Mac
	     Catalyst, run as a process; the iOS simulator, installed and launched; an iOS device,
	     linked and inspected, since no runner has one). HyperCast's AppleSmokeTest is the
	     model. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
		<IsPackable>false</IsPackable>
		<ApplicationId>io.github.skunkwerkx.hypertabular.applesmoketest</ApplicationId>
		<ApplicationTitle>HyperTabular smoke test</ApplicationTitle>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="../HyperTabular.AotSmokeTest/Program.cs" Link="Program.cs" />
		<Compile Include="../HyperTabular.AotSmokeTest/SmokeTest.cs" Link="SmokeTest.cs" />
		<ProjectReference Include="../HyperTabular/HyperTabular.csproj" />
	</ItemGroup>

	<!-- The workbook SmokeTest.cs reads, compiled in as the Native AOT smoke test compiles it:
	     an app in the simulator has no corpus/ beside it. -->
	<ItemGroup>
		<EmbeddedResource Include="../../corpus/workbook/basic.xlsx" LogicalName="basic.xlsx" />
	</ItemGroup>

	<!-- By hand, for the reason HyperTabular.AotSmokeTest gives: a project reference gets none
	     of a NuGet package's build/ imports, and this is the project that proves the branch of
	     that file a .NET iOS or Mac Catalyst consumer takes. The archive it links is
	     csharp/HyperTabular/staticlibs/{rid}/, staged from the static-libs artifact. HyperCast
	     arrives as a package, so its own targets link libhypercast.a beside it, which is the
	     pairing every real consumer gets. -->
	<Import Project="../HyperTabular/build/net10.0/HyperTabular.targets" />

</Project>
