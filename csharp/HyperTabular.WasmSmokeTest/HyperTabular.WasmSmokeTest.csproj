<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- TargetFramework, LangVersion and Nullable/ImplicitUsings come from
       csharp/Directory.Build.props, shared with every project here. -->
  <PropertyGroup>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetSpaFallbackEnabled>true</StaticWebAssetSpaFallbackEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Gateway" Version="11.0.0-rc.1.26425.128" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The managed binding, through its real public surface: this app declares no P/Invokes
         of its own. HyperCast arrives through the binding's PackageReference, as a consumer
         gets it, and its package's own build/ targets link HyperCast's archive in beside this
         one: two no_std Hyper* archives in one wasm module. -->
    <ProjectReference Include="../HyperTabular/HyperTabular.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Workbooks the page reads from memory: a browser app holds bytes, not paths. -->
    <EmbeddedResource Include="../../corpus/workbook/basic.xlsx" LogicalName="basic.xlsx" />
    <EmbeddedResource Include="../../corpus/workbook/basic.ods" LogicalName="basic.ods" />
  </ItemGroup>

  <!-- What a NuGet consumer gets for free and a ProjectReference does not: the package's
       build/{tfm}/HyperTabular.targets is only auto-imported from a restored package.
       Importing it by hand means this app links through the *shipped* NativeFileReference
       and EmccExportedFunction wiring rather than a copy of it, so an export missing from
       that list fails here at run time exactly as it would for a real Blazor consumer.

       Needs the wasm32-unknown-emscripten staticlib staged where the targets file looks for
       it, csharp/HyperTabular/runtimes/browser-wasm/nativeassets/net10.0/libhypertabular.a,
       which is gitignored like every other runtimes/ asset. check.sh stages it. -->
  <Import Project="../HyperTabular/build/net11.0/HyperTabular.targets" />

</Project>
